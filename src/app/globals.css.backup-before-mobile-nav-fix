:root {
  color-scheme: light;
  --cream: #fbf7ef;
  --ivory: #fffdf7;
  --linen: #efe4d2;
  --sand: #d9c7aa;
  --tan: #bda889;
  --sage: #7f927d;
  --sage-dark: #52654f;
  --sage-soft: #dce5d8;
  --olive: #6f7a58;
  --gold: #b99a5d;
  --gold-soft: #e2cf9c;
  --brown: #33271f;
  --brown-soft: #6f6256;
  --border: rgba(51, 39, 31, 0.14);
  --shadow: 0 24px 80px rgba(51, 39, 31, 0.13);
  --shadow-heavy: 0 34px 110px rgba(51, 39, 31, 0.2);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

::selection {
  background: rgba(185, 154, 93, 0.28);
  color: var(--brown);
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(circle at top left, rgba(127, 146, 125, 0.18), transparent 36rem),
    radial-gradient(circle at bottom right, rgba(185, 154, 93, 0.14), transparent 34rem),
    linear-gradient(180deg, var(--cream) 0%, #f4eadb 100%);
  color: var(--brown);
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

button,
input,
textarea,
select {
  font: inherit;
}

[hidden] {
  display: none !important;
}

a:focus-visible,
summary:focus-visible {
  outline: 3px solid rgba(82, 101, 79, 0.32);
  outline-offset: 4px;
}

button,
summary,
a {
  -webkit-tap-highlight-color: transparent;
}

.site-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 0.9rem clamp(1rem, 4vw, 4.5rem);
  background: rgba(255, 253, 247, 0.78);
  border-bottom: 1px solid rgba(51, 39, 31, 0.1);
  color: var(--brown);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  animation: headerIn 700ms ease both;
}

.brand {
  display: flex;
  align-items: center;
  min-width: max-content;
  gap: 0.8rem;
}

.brand-mark {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border: 1px solid rgba(185, 154, 93, 0.45);
  border-radius: 999px;
  background:
    radial-gradient(circle at 30% 20%, rgba(226, 207, 156, 0.7), transparent 34%),
    rgba(255, 253, 247, 0.88);
  color: var(--sage-dark);
  font-weight: 900;
  box-shadow: 0 12px 34px rgba(51, 39, 31, 0.1);
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  letter-spacing: 0.02em;
}

.brand small {
  color: var(--brown-soft);
  font-size: 0.74rem;
}

.nav {
  display: flex;
  align-items: center;
  gap: 1.1rem;
  color: var(--brown-soft);
  font-size: 0.78rem;
  font-weight: 850;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.nav a {
  position: relative;
}

.nav a::after {
  position: absolute;
  right: 0;
  bottom: -0.45rem;
  left: 0;
  height: 1px;
  background: var(--sage);
  content: "";
  opacity: 0;
  transform: scaleX(0.4);
  transition:
    opacity 180ms ease,
    transform 180ms ease;
}

.nav a:hover::after {
  opacity: 1;
  transform: scaleX(1);
}

.nav-cta,
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-weight: 850;
}

.nav-cta {
  min-width: max-content;
  padding: 0.78rem 1.15rem;
  border: 1px solid rgba(82, 101, 79, 0.28);
  background: var(--sage-dark);
  color: var(--ivory);
  letter-spacing: 0.04em;
  box-shadow: 0 14px 34px rgba(82, 101, 79, 0.16);
}

.organic-hero {
  position: relative;
  display: grid;
  min-height: 100vh;
  min-height: 100svh;
  place-items: center;
  overflow: hidden;
  padding: 8rem clamp(1rem, 4vw, 4.5rem) 4rem;
  color: var(--brown);
  text-align: center;
}

.hero-media {
  position: absolute;
  inset: 0;
  z-index: -3;
  background:
    radial-gradient(circle at 50% 42%, rgba(255, 253, 247, 0.62), transparent 30rem),
    linear-gradient(135deg, #efe4d2, #d9c7aa 55%, #c8b18c);
}

.hero-media video,
.hero-media-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-media video {
  object-fit: cover;
  opacity: 0.55;
}

.hero-media-placeholder {
  background:
    linear-gradient(rgba(251, 247, 239, 0.16), rgba(251, 247, 239, 0.52)),
    radial-gradient(circle at 72% 28%, rgba(127, 146, 125, 0.28), transparent 26rem),
    radial-gradient(circle at 22% 70%, rgba(185, 154, 93, 0.18), transparent 30rem),
    linear-gradient(115deg, #f2e8d8 0%, #dfcfb4 48%, #b7c2aa 100%);
  animation: slowGradient 14s ease-in-out infinite alternate;
}

.hero-wash {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(circle at center, rgba(255, 253, 247, 0.16), rgba(255, 253, 247, 0.78) 78%),
    linear-gradient(90deg, rgba(251, 247, 239, 0.86), rgba(251, 247, 239, 0.3), rgba(251, 247, 239, 0.84));
}

.botanical-pattern {
  position: absolute;
  inset: 0;
  z-index: 2;
  background-image:
    radial-gradient(circle at 12px 12px, rgba(82, 101, 79, 0.08) 2px, transparent 2px),
    linear-gradient(90deg, rgba(82, 101, 79, 0.045) 1px, transparent 1px),
    linear-gradient(rgba(82, 101, 79, 0.045) 1px, transparent 1px);
  background-size: 48px 48px, 96px 96px, 96px 96px;
  mask-image: radial-gradient(circle at center, black 0%, transparent 76%);
  -webkit-mask-image: radial-gradient(circle at center, black 0%, transparent 76%);
  opacity: 0.85;
  animation: patternDrift 26s linear infinite;
}

.ambient-orb {
  position: absolute;
  z-index: 3;
  width: 22rem;
  height: 22rem;
  border-radius: 999px;
  filter: blur(18px);
  opacity: 0.34;
  pointer-events: none;
  mix-blend-mode: multiply;
}

.orb-one {
  top: 14%;
  left: 7%;
  background: radial-gradient(circle, rgba(127, 146, 125, 0.48), transparent 68%);
  animation: floatOrbOne 11s ease-in-out infinite alternate;
}

.orb-two {
  right: 8%;
  bottom: 10%;
  background: radial-gradient(circle, rgba(185, 154, 93, 0.36), transparent 68%);
  animation: floatOrbTwo 13s ease-in-out infinite alternate;
}

.hero-inner {
  position: relative;
  z-index: 5;
  width: min(1040px, 100%);
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  margin: 0 0 1.4rem;
  padding: 0.52rem 0.95rem;
  border: 1px solid rgba(82, 101, 79, 0.18);
  border-radius: 999px;
  background: rgba(255, 253, 247, 0.62);
  color: var(--sage-dark);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.hero-pill span {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--sage);
  box-shadow: 0 0 14px rgba(127, 146, 125, 0.72);
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 1.2rem;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3.2rem, 7.8vw, 7.8rem);
  font-weight: 500;
  line-height: 0.92;
  letter-spacing: -0.075em;
  text-wrap: balance;
}

.organic-hero h1 {
  text-shadow: 0 18px 50px rgba(255, 253, 247, 0.62);
}

h2 {
  margin-bottom: 1rem;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.25rem, 5vw, 4.7rem);
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.055em;
  text-wrap: balance;
}

h3 {
  margin-bottom: 0.7rem;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.55rem;
}

.hero-copy {
  max-width: 700px;
  margin-inline: auto;
  color: var(--brown-soft);
  font-size: clamp(1.05rem, 2vw, 1.32rem);
  line-height: 1.8;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.85rem;
  margin-top: 2rem;
}

.button {
  position: relative;
  min-height: 52px;
  overflow: hidden;
  padding: 0.95rem 1.4rem;
  border: 1px solid var(--border);
  isolation: isolate;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.button::before {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    110deg,
    transparent,
    rgba(255, 253, 247, 0.35),
    transparent
  );
  content: "";
  transform: translateX(-120%);
  transition: transform 620ms ease;
}

.button:hover {
  box-shadow: 0 20px 44px rgba(51, 39, 31, 0.16);
  transform: translateY(-2px);
}

.button:hover::before {
  transform: translateX(120%);
}

.button.primary {
  border-color: rgba(82, 101, 79, 0.2);
  background: linear-gradient(135deg, var(--sage-dark), var(--olive));
  color: var(--ivory);
  box-shadow: 0 18px 44px rgba(82, 101, 79, 0.2);
}

.button.secondary {
  border-color: rgba(51, 39, 31, 0.13);
  background: rgba(255, 253, 247, 0.62);
  color: var(--brown);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.65rem;
  margin-top: 2.25rem;
}

.hero-tags span {
  padding: 0.48rem 0.75rem;
  border: 1px solid rgba(82, 101, 79, 0.16);
  border-radius: 999px;
  background: rgba(255, 253, 247, 0.58);
  color: var(--sage-dark);
  font-size: 0.82rem;
  font-weight: 700;
  box-shadow: 0 14px 36px rgba(51, 39, 31, 0.06);
}

.hero-stat-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  max-width: 880px;
  gap: 0.8rem;
  margin: 2.7rem auto 0;
}

.hero-stat-row div {
  display: grid;
  gap: 0.35rem;
  padding: 1rem;
  border: 1px solid rgba(82, 101, 79, 0.16);
  border-radius: 1.25rem;
  background: rgba(255, 253, 247, 0.48);
  box-shadow: 0 20px 60px rgba(51, 39, 31, 0.08);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.hero-stat-row strong {
  color: var(--sage-dark);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.15rem;
  font-weight: 500;
}

.hero-stat-row span {
  color: var(--brown-soft);
  font-size: 0.86rem;
  line-height: 1.5;
}


.eyebrow {
  margin: 0 0 1rem;
  color: var(--sage-dark);
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.mini-eyebrow {
  margin-bottom: 0.55rem;
  color: var(--gold);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.section {
  position: relative;
  padding: clamp(4rem, 7vw, 7rem) clamp(1rem, 4vw, 4.5rem);
}

.section-lift {
  margin-inline: clamp(0rem, 2vw, 2rem);
}

.split {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(2rem, 5vw, 5rem);
  align-items: start;
}

.copy-stack {
  display: grid;
  gap: 1rem;
}

.premium-copy-card,
.comfort-inner,
.booking-card,
.service-card,
.expect-card,
.review-card,
.pricing-grid div,
.faq-list details {
  position: relative;
}

.premium-copy-card::before,
.comfort-inner::before,
.booking-card::before,
.service-card::before,
.expect-card::before,
.review-card::before,
.pricing-grid div::before,
.faq-list details::before {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255, 253, 247, 0.45),
    transparent 38%,
    rgba(185, 154, 93, 0.08)
  );
  content: "";
  opacity: 0.75;
  pointer-events: none;
}

.premium-copy-card {
  padding: clamp(1.25rem, 3vw, 2rem);
  border: 1px solid rgba(51, 39, 31, 0.1);
  border-radius: 1.6rem;
  background: rgba(255, 253, 247, 0.58);
  box-shadow: 0 22px 70px rgba(51, 39, 31, 0.07);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.section-heading {
  max-width: 780px;
  margin-bottom: 2rem;
}

.section-heading.centered {
  margin-inline: auto;
  text-align: center;
}

.section-heading p,
.section p {
  color: var(--brown-soft);
  font-size: 1.05rem;
  line-height: 1.8;
}

.scroll-reveal {
  opacity: 0;
  transform: translateY(26px);
  transition:
    opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
}

.scroll-reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.services-section::before {
  position: absolute;
  top: 3rem;
  right: 5vw;
  width: 12rem;
  height: 12rem;
  border: 1px solid rgba(82, 101, 79, 0.12);
  border-radius: 999px;
  content: "";
}

.service-grid,
.expect-grid,
.review-grid,
.pricing-grid {
  perspective: 1200px;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.service-card {
  overflow: hidden;
  padding: 1rem;
  border: 1px solid var(--border);
  border-radius: 1.6rem;
  background: rgba(255, 253, 247, 0.78);
  box-shadow: 0 14px 44px rgba(51, 39, 31, 0.08);
  transition:
    transform 240ms ease,
    box-shadow 240ms ease,
    border-color 240ms ease;
}

.service-card::after {
  position: absolute;
  inset: auto 1.1rem 1.1rem auto;
  width: 4.5rem;
  height: 4.5rem;
  border: 1px solid rgba(185, 154, 93, 0.22);
  border-radius: 999px;
  content: "";
  opacity: 0.7;
}

.service-card:hover {
  border-color: rgba(82, 101, 79, 0.28);
  box-shadow: var(--shadow-heavy);
  transform: translateY(-7px) rotateX(1deg);
}

.service-card-link {
  display: block;
  color: inherit;
}

.service-content {
  position: relative;
  z-index: 1;
  padding: 0.2rem;
}

.service-card p {
  min-height: 105px;
}

.service-card small {
  display: block;
  margin-top: 1rem;
  color: var(--sage-dark);
  font-size: 0.9rem;
  font-weight: 800;
  line-height: 1.55;
}

.service-link-text {
  position: relative;
  z-index: 1;
  display: inline-flex;
  margin-top: 1.1rem;
  color: var(--sage-dark);
  font-size: 0.9rem;
  font-weight: 900;
}

.service-image {
  position: relative;
  z-index: 1;
  display: grid;
  min-height: 250px;
  margin-bottom: 1rem;
  place-items: center;
  overflow: hidden;
  border-radius: 1.1rem;
  background:
    linear-gradient(rgba(51, 39, 31, 0.03), rgba(51, 39, 31, 0.11)),
    linear-gradient(135deg, #ede2d0, #c4b08f 48%, #a9b79f);
  color: rgba(51, 39, 31, 0.55);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 3.6rem;
  font-weight: 500;
}

.service-image::before {
  position: absolute;
  inset: -30%;
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 253, 247, 0.5), transparent 22%),
    radial-gradient(circle at 70% 60%, rgba(82, 101, 79, 0.22), transparent 26%);
  content: "";
  animation: imageGlow 9s ease-in-out infinite alternate;
}

.service-image span {
  position: relative;
  z-index: 1;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: 1rem;
}

.chip-row span {
  padding: 0.35rem 0.6rem;
  border: 1px solid rgba(82, 101, 79, 0.16);
  border-radius: 999px;
  background: rgba(127, 146, 125, 0.08);
  color: var(--sage-dark);
  font-size: 0.76rem;
  font-weight: 800;
}

.expect-section {
  background:
    radial-gradient(circle at top right, rgba(127, 146, 125, 0.12), transparent 28rem),
    rgba(255, 253, 247, 0.38);
}

.expect-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1rem;
}

.expect-card {
  overflow: hidden;
  min-height: 280px;
  padding: 1.2rem;
  border: 1px solid var(--border);
  border-radius: 1.4rem;
  background: rgba(255, 253, 247, 0.72);
  box-shadow: 0 18px 48px rgba(51, 39, 31, 0.06);
  transition:
    transform 220ms ease,
    box-shadow 220ms ease,
    border-color 220ms ease;
}

.expect-card:hover {
  border-color: rgba(82, 101, 79, 0.22);
  box-shadow: var(--shadow);
  transform: translateY(-5px);
}

.sheet-card {
  position: relative;
  isolation: isolate;
  min-height: 320px;
  cursor: pointer;
  outline: none;
  background:
    radial-gradient(circle at top left, rgba(255, 253, 247, 0.9), transparent 22rem),
    rgba(255, 253, 247, 0.72);
}

.expect-sheet {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 0.75rem;
  padding: 1.25rem;
  border-radius: inherit;
  background:
    linear-gradient(135deg, rgba(255, 253, 247, 0.96), rgba(239, 228, 210, 0.92)),
    radial-gradient(circle at 30% 20%, rgba(255, 253, 247, 0.9), transparent 30%),
    linear-gradient(120deg, rgba(127, 146, 125, 0.08), transparent);
  box-shadow:
    inset 0 -24px 46px rgba(51, 39, 31, 0.08),
    0 18px 50px rgba(51, 39, 31, 0.1);
  transform-origin: top center;
  transition:
    transform 720ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 720ms cubic-bezier(0.22, 1, 0.36, 1);
}

.expect-sheet::before {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background-image:
    linear-gradient(90deg, rgba(51, 39, 31, 0.035) 1px, transparent 1px),
    linear-gradient(rgba(51, 39, 31, 0.025) 1px, transparent 1px);
  background-size: 34px 34px;
  content: "";
  opacity: 0.42;
  pointer-events: none;
}

.expect-sheet::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 42%;
  background:
    linear-gradient(
      180deg,
      transparent,
      rgba(189, 168, 137, 0.16) 52%,
      rgba(51, 39, 31, 0.08)
    );
  content: "";
  pointer-events: none;
}

.expect-sheet h3 {
  position: relative;
  z-index: 1;
  max-width: 15rem;
  margin: 0;
  color: var(--brown);
  text-align: center;
}

.sheet-hint {
  position: relative;
  z-index: 1;
  color: var(--sage-dark);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  opacity: 0.72;
}

.expect-reveal {
  position: relative;
  z-index: 2;
  display: grid;
  align-content: start;
  min-height: 100%;
  padding: 0.15rem;
  opacity: 0;
  transform: translateY(18px);
  transition:
    opacity 520ms ease 140ms,
    transform 520ms ease 140ms;
}

.expect-reveal > span {
  display: inline-flex;
  margin-bottom: 1.2rem;
  color: var(--gold);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 2rem;
}

.expect-reveal h3 {
  margin-bottom: 0.9rem;
}

.expect-reveal p {
  color: var(--brown-soft);
  font-size: 0.98rem;
  line-height: 1.65;
}

.sheet-card:hover,
.sheet-card:focus-visible {
  border-color: rgba(82, 101, 79, 0.26);
  box-shadow: var(--shadow);
  transform: translateY(-5px);
}

.sheet-card:hover .expect-sheet,
.sheet-card:focus-visible .expect-sheet {
  box-shadow:
    inset 0 -16px 36px rgba(51, 39, 31, 0.06),
    0 30px 70px rgba(51, 39, 31, 0.14);
  transform: translateY(-74%) rotateX(8deg);
}

.sheet-card:hover .expect-reveal,
.sheet-card:focus-visible .expect-reveal {
  opacity: 1;
  transform: translateY(0);
}

.sheet-card:hover .expect-sheet h3,
.sheet-card:focus-visible .expect-sheet h3,
.sheet-card:hover .sheet-hint,
.sheet-card:focus-visible .sheet-hint {
  opacity: 0;
  transform: translateY(-8px);
  transition:
    opacity 260ms ease,
    transform 260ms ease;
}

.comfort-section {
  display: grid;
  place-items: center;
  background:
    linear-gradient(rgba(82, 101, 79, 0.08), rgba(82, 101, 79, 0.08)),
    var(--linen);
}

.comfort-inner {
  overflow: hidden;
  width: min(980px, 100%);
  padding: clamp(1.5rem, 4vw, 3.2rem);
  border: 1px solid rgba(82, 101, 79, 0.16);
  border-radius: 2.2rem;
  background:
    radial-gradient(circle at top left, rgba(255, 253, 247, 0.75), transparent 26rem),
    rgba(255, 253, 247, 0.48);
  box-shadow: var(--shadow);
  text-align: center;
}

.comfort-inner > * {
  position: relative;
  z-index: 1;
}

.comfort-inner p {
  max-width: 760px;
  margin-inline: auto;
}

.experience-section {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
  gap: 1rem;
  background:
    radial-gradient(circle at top right, rgba(255, 253, 247, 0.24), transparent 30rem),
    linear-gradient(135deg, var(--sage-dark), #6f7a58);
  color: var(--ivory);
}

.experience-card {
  padding: clamp(1.4rem, 4vw, 3rem);
  border: 1px solid rgba(255, 253, 247, 0.22);
  border-radius: 2rem;
  background: rgba(255, 253, 247, 0.08);
  box-shadow: 0 24px 90px rgba(0, 0, 0, 0.1);
}

.experience-card .eyebrow {
  color: var(--gold-soft);
}

.experience-card p {
  color: rgba(255, 253, 247, 0.78);
}

.experience-list {
  display: grid;
  gap: 1rem;
}

.experience-list div {
  display: grid;
  gap: 0.4rem;
  padding: 1.2rem;
  border: 1px solid rgba(255, 253, 247, 0.2);
  border-radius: 1.4rem;
  background: rgba(255, 253, 247, 0.08);
  transition:
    transform 200ms ease,
    background 200ms ease;
}

.experience-list div:hover {
  background: rgba(255, 253, 247, 0.12);
  transform: translateX(6px);
}

.experience-list strong {
  color: var(--gold-soft);
}

.experience-list span {
  color: rgba(255, 253, 247, 0.72);
  line-height: 1.6;
}

.soft {
  background:
    radial-gradient(circle at top left, rgba(127, 146, 125, 0.12), transparent 28rem),
    rgba(255, 253, 247, 0.55);
  border-block: 1px solid var(--border);
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.pricing-grid div {
  overflow: hidden;
  display: grid;
  gap: 0.35rem;
  padding: 1.3rem;
  border: 1px solid var(--border);
  border-radius: 1.2rem;
  background: var(--ivory);
  box-shadow: 0 18px 48px rgba(51, 39, 31, 0.06);
  transition:
    transform 220ms ease,
    box-shadow 220ms ease;
}

.pricing-grid div:hover {
  box-shadow: var(--shadow);
  transform: translateY(-4px);
}

.pricing-grid strong,
.pricing-grid span {
  position: relative;
  z-index: 1;
}

.pricing-grid strong {
  font-size: 1.2rem;
}

.pricing-grid span {
  color: var(--brown-soft);
}

.reviews-section {
  background:
    radial-gradient(circle at top left, rgba(185, 154, 93, 0.11), transparent 26rem),
    var(--cream);
}

.review-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.review-card {
  overflow: hidden;
  padding: 1.4rem;
  border: 1px solid var(--border);
  border-radius: 1.5rem;
  background: rgba(255, 253, 247, 0.72);
  box-shadow: 0 18px 48px rgba(51, 39, 31, 0.06);
  transition:
    transform 220ms ease,
    box-shadow 220ms ease;
}

.review-card:hover {
  box-shadow: var(--shadow);
  transform: translateY(-5px);
}

.review-card > * {
  position: relative;
  z-index: 1;
}

.stars {
  margin-bottom: 1rem;
  color: var(--gold);
  letter-spacing: 0.1em;
}

.review-card p {
  color: var(--brown-soft);
  line-height: 1.75;
}

.review-card small {
  color: var(--sage-dark);
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.booking-section {
  display: grid;
  place-items: center;
}

.booking-card {
  overflow: hidden;
  width: min(920px, 100%);
  padding: clamp(1.6rem, 4vw, 3rem);
  border: 1px solid rgba(82, 101, 79, 0.16);
  border-radius: 2rem;
  background:
    linear-gradient(rgba(255, 253, 247, 0.78), rgba(255, 253, 247, 0.86)),
    radial-gradient(circle at top right, rgba(185, 154, 93, 0.18), transparent 24rem);
  box-shadow: var(--shadow);
  text-align: center;
}

.booking-card > * {
  position: relative;
  z-index: 1;
}

.faq-section {
  background:
    radial-gradient(circle at bottom right, rgba(127, 146, 125, 0.14), transparent 28rem),
    rgba(255, 253, 247, 0.35);
}

.faq-list {
  display: grid;
  gap: 0.75rem;
  max-width: 980px;
}

.faq-list details {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 1rem;
  background: rgba(255, 253, 247, 0.72);
  box-shadow: 0 14px 36px rgba(51, 39, 31, 0.05);
  transition:
    box-shadow 200ms ease,
    transform 200ms ease;
}

.faq-list details:hover {
  box-shadow: 0 20px 50px rgba(51, 39, 31, 0.08);
  transform: translateY(-2px);
}

.faq-list summary {
  position: relative;
  z-index: 1;
  cursor: pointer;
  padding: 1.1rem 1.2rem;
  color: var(--brown);
  font-weight: 850;
  list-style: none;
}

.faq-list summary::-webkit-details-marker {
  display: none;
}

.faq-list summary::after {
  float: right;
  color: var(--sage-dark);
  content: "+";
}

.faq-list details[open] summary::after {
  content: "–";
}

.faq-list details p {
  position: relative;
  z-index: 1;
  margin: 0;
  padding: 0 1.2rem 1.2rem;
  color: var(--brown-soft);
  line-height: 1.75;
}

/* -------------------------------------------------------------------------- */
/* Brand logo image lockup                                                    */
/* -------------------------------------------------------------------------- */

.brand-logo-link {
