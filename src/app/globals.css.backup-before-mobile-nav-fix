/* -------------------------------------------------------------------------- */
/* Premium footer                                                             */
/* -------------------------------------------------------------------------- */

.footer,
.premium-footer {
  position: relative;
  overflow: hidden;
  padding: clamp(4rem, 7vw, 6.5rem) clamp(1rem, 4vw, 4.5rem) 1.35rem;
  border-top: 1px solid rgba(51, 39, 31, 0.1);
  background:
    radial-gradient(circle at 12% 10%, rgba(127, 146, 125, 0.16), transparent 30rem),
    radial-gradient(circle at 88% 20%, rgba(185, 154, 93, 0.12), transparent 26rem),
    linear-gradient(135deg, #fbf7ef 0%, #f2e8d8 48%, #efe4d2 100%);
  color: var(--brown-soft);
}

.footer-shell {
  position: relative;
  z-index: 2;
  width: min(1540px, 100%);
  margin-inline: auto;
}

.footer-orb {
  position: absolute;
  border-radius: 999px;
  pointer-events: none;
  filter: blur(14px);
  opacity: 0.7;
}

.footer-orb-one {
  top: -8rem;
  left: -8rem;
  width: 24rem;
  height: 24rem;
  background: radial-gradient(circle, rgba(127, 146, 125, 0.2), transparent 68%);
  animation: footerFloatOne 14s ease-in-out infinite alternate;
}

.footer-orb-two {
  right: -10rem;
  bottom: -12rem;
  width: 28rem;
  height: 28rem;
  background: radial-gradient(circle, rgba(185, 154, 93, 0.16), transparent 70%);
  animation: footerFloatTwo 16s ease-in-out infinite alternate;
}

.footer-glow {
  position: absolute;
  right: -8rem;
  bottom: -10rem;
  width: 28rem;
  height: 28rem;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(127, 146, 125, 0.24), transparent 68%);
  filter: blur(8px);
  opacity: 0.7;
  pointer-events: none;
}

.footer-texture {
  position: absolute;
  inset: 0;
  z-index: 1;
  background-image:
    radial-gradient(circle at 12px 12px, rgba(82, 101, 79, 0.04) 1.5px, transparent 1.5px),
    linear-gradient(90deg, rgba(82, 101, 79, 0.025) 1px, transparent 1px),
    linear-gradient(rgba(82, 101, 79, 0.025) 1px, transparent 1px);
  background-size: 54px 54px, 108px 108px, 108px 108px;
  opacity: 0.65;
  pointer-events: none;
}

.footer-cta-panel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: clamp(1.5rem, 4vw, 3rem);
  align-items: center;
  margin-bottom: clamp(3rem, 6vw, 5rem);
  padding: clamp(1.5rem, 4vw, 3rem);
  overflow: hidden;
  border: 1px solid rgba(82, 101, 79, 0.14);
  border-radius: 2rem;
  background:
    linear-gradient(rgba(255, 253, 247, 0.74), rgba(255, 253, 247, 0.88)),
    radial-gradient(circle at top right, rgba(127, 146, 125, 0.14), transparent 28rem),
    radial-gradient(circle at bottom left, rgba(185, 154, 93, 0.1), transparent 24rem);
  box-shadow: 0 30px 100px rgba(51, 39, 31, 0.1);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.footer-cta-panel::before {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    linear-gradient(120deg, rgba(255, 253, 247, 0.5), transparent 42%),
    linear-gradient(90deg, rgba(255, 253, 247, 0.18) 1px, transparent 1px);
  background-size: auto, 64px 64px;
  content: "";
  opacity: 0.85;
  pointer-events: none;
}

.footer-cta-panel > * {
  position: relative;
  z-index: 1;
}

.footer-kicker {
  margin-bottom: 0.7rem;
  color: var(--sage-dark);
  font-size: 0.76rem;
  font-weight: 950;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.footer-cta-panel h2 {
  max-width: 900px;
  margin-bottom: 0.85rem;
  color: var(--brown);
  font-size: clamp(2rem, 4.6vw, 4rem);
  line-height: 0.98;
  letter-spacing: -0.05em;
}

.footer-cta-panel p {
  max-width: 760px;
  margin-bottom: 0;
  color: var(--brown-soft);
  font-size: clamp(1rem, 1.7vw, 1.12rem);
  line-height: 1.8;
}

.footer-primary-action,
.footer-booking-link {
  display: inline-flex;
  min-height: 54px;
  align-items: center;
  justify-content: center;
  width: fit-content;
  padding: 0.95rem 1.35rem;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--sage-dark), var(--olive));
  color: var(--ivory) !important;
  font-weight: 950;
  box-shadow: 0 18px 46px rgba(82, 101, 79, 0.24);
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    opacity 180ms ease;
}

.footer-primary-action:hover,
.footer-booking-link:hover {
  box-shadow: 0 24px 60px rgba(82, 101, 79, 0.28);
  transform: translateY(-3px);
}

.premium-footer .footer-main,
.footer-main {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: minmax(320px, 1.4fr) minmax(140px, 0.5fr) minmax(220px, 0.7fr) minmax(250px, 0.8fr);
  gap: clamp(2rem, 5vw, 5rem);
  align-items: start;
  padding-bottom: clamp(2.4rem, 5vw, 4rem);
}

.footer-brand-block {
  max-width: 580px;
}

.footer-brand-description,
.footer-brand-block > p,
.footer-column p {
  color: var(--brown-soft);
  line-height: 1.78;
}

.footer-brand-description {
  margin-top: 1.15rem;
}

.footer-status {
  display: inline-flex;
  align-items: center;
  gap: 0.48rem;
  margin-top: 1.15rem;
  padding: 0.56rem 0.88rem;
  border: 1px solid rgba(82, 101, 79, 0.16);
  border-radius: 999px;
  background: rgba(255, 253, 247, 0.62);
  color: var(--sage-dark);
  font-size: 0.76rem;
  font-weight: 950;
  box-shadow: 0 14px 34px rgba(51, 39, 31, 0.06);
}

.footer-status span {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--sage);
  box-shadow: 0 0 14px rgba(127, 146, 125, 0.72);
}

.footer-column {
  display: grid;
  align-content: start;
  gap: 1rem;
}

.footer-column > strong {
  color: var(--brown);
  font-size: 0.76rem;
  font-weight: 950;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.footer-column nav {
  display: grid;
  gap: 0.62rem;
}

.footer-column a {
  width: fit-content;
  color: var(--brown-soft);
  font-size: 0.98rem;
  line-height: 1.45;
  transition:
    color 180ms ease,
    transform 180ms ease;
}

.footer-column a:hover {
  color: var(--sage-dark);
  transform: translateX(4px);
}

.footer-contact {
  position: relative;
  overflow: hidden;
  padding: 1.2rem;
  border: 1px solid rgba(82, 101, 79, 0.14);
  border-radius: 1.5rem;
  background:
    linear-gradient(rgba(255, 253, 247, 0.62), rgba(255, 253, 247, 0.82)),
    radial-gradient(circle at top right, rgba(127, 146, 125, 0.12), transparent 16rem);
  box-shadow: 0 20px 64px rgba(51, 39, 31, 0.08);
}

.footer-contact::before {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255, 253, 247, 0.42), transparent 42%);
  content: "";
  pointer-events: none;
}

.footer-contact > * {
  position: relative;
  z-index: 1;
}

.footer-booking-link {
  margin-top: 0.45rem;
  padding: 0.84rem 1rem;
  box-shadow: 0 16px 36px rgba(82, 101, 79, 0.2);
}

.footer-bottom {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(51, 39, 31, 0.1);
  color: rgba(111, 98, 86, 0.88);
  font-size: 0.88rem;
}

.footer-bottom p {
  margin: 0;
}

.developer-signature {
  text-align: right;
}

.developer-signature span,
.developer-signature a {
  color: var(--sage-dark);
  font-weight: 950;
}

.developer-signature a {
  transition: color 180ms ease;
}

.developer-signature a:hover {
  color: var(--gold);
}

.mobile-sticky-book {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 80;
  display: none;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  padding: 0.9rem 1.3rem;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--sage-dark), var(--olive));
  color: var(--ivory);
  font-weight: 900;
  box-shadow: 0 18px 42px rgba(82, 101, 79, 0.34);
}

.reveal-up {
  animation: revealUp 780ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.reveal-soft {
  animation: revealSoft 900ms ease 850ms both;
}

.delay-1 {
  animation-delay: 120ms;
}

.delay-2 {
  animation-delay: 240ms;
}

.delay-3 {
  animation-delay: 360ms;
}

.delay-4 {
  animation-delay: 480ms;
}

.delay-5 {
  animation-delay: 620ms;
}

@keyframes headerIn {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes revealUp {
  from {
    opacity: 0;
    transform: translateY(22px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes revealSoft {
  from {
    opacity: 0;
    transform: translateY(18px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes slowGradient {
  from {
    filter: saturate(1) brightness(1);
    transform: scale(1);
  }

  to {
    filter: saturate(1.12) brightness(1.04);
    transform: scale(1.04);
  }
}

@keyframes patternDrift {
  from {
    background-position: 0 0, 0 0, 0 0;
  }

  to {
    background-position: 48px 48px, 96px 0, 0 96px;
  }
}

@keyframes floatOrbOne {
  from {
    transform: translate3d(0, 0, 0) scale(1);
  }

  to {
    transform: translate3d(2rem, 1.2rem, 0) scale(1.08);
  }
}

@keyframes floatOrbTwo {
  from {
    transform: translate3d(0, 0, 0) scale(1);
  }

  to {
    transform: translate3d(-1.6rem, -1rem, 0) scale(1.05);
  }
}

@keyframes imageGlow {
  from {
    transform: rotate(0deg) scale(1);
  }

  to {
    transform: rotate(8deg) scale(1.08);
  }
}

